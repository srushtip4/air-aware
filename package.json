{
  "name": "airaware",
  "private": true,
  "version": "1.0.0",
  "description": "GenAI-powered winter smog and urban air quality assistant with deterministic clean-air plans and transparent impact estimates.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --format=esm --outfile=dist-server/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server coverage",
    "lint": "oxlint -c oxlint.json server.ts src tests scripts playwright.config.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:http": "node scripts/verify-http.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  }
}
